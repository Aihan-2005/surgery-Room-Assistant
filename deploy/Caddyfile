{$SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		# Includes the multipart envelope around a 5 MiB upload.
		max_size 6MiB
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Photos are served only through authenticated Django views.
	handle /media/* {
		respond 404
	}

	# Keep the slash-terminated Django push API distinct from Next.js proxies.
	@django path /admin /admin/* /api/health/ /api/devices/* /api/assessments/* /api/push/config/ /api/push/subscriptions/ /api/push/test/
	handle @django {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				response_header_timeout 600s
			}
		}
	}

	# Next.js owns /api/device/*, /api/sync/*, /api/backend-health and
	# /api/push/config, /api/push/subscriptions, /api/push/test (without a slash).
	handle {
		reverse_proxy frontend:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
