# Copy to /etc/airway/compose.env on the VPS, chmod 600, and edit there.
# HTTP is temporary for testing. Replace YOUR_SERVER_IP in both values.
SITE_ADDRESS=:80
APP_HOST=YOUR_SERVER_IP
APP_ORIGIN=http://YOUR_SERVER_IP
DJANGO_COOKIE_SECURE=0
HSTS_SECONDS=0
# Generate each separately with: openssl rand -hex 32
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# Must match the lowercase GitHub repository path. CI uses commit SHA tags.
IMAGE_PREFIX=ghcr.io/aihan-2005/surgery-room-assistant
# For a first build directly on the VPS, leave IMAGE_TAG=local.
IMAGE_TAG=local

# Optional: for local VPS builds when Debian's main mirror is unreachable.
# These build settings do not affect prebuilt images pulled from GHCR.
# DEBIAN_MIRROR=https://mirror.parsvds.com/debian
# DEBIAN_SECURITY_MIRROR=https://security.debian.org/debian-security

# Once DNS points to the VPS and ports 80/443 are open, change the above to:
# SITE_ADDRESS=app.yourdomain.com
# APP_HOST=app.yourdomain.com
# APP_ORIGIN=https://app.yourdomain.com
# DJANGO_COOKIE_SECURE=1
# HSTS_SECONDS=3600
