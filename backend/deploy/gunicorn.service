[Unit]
Description=Airway assessment API
After=network.target postgresql.service

[Service]
User=airway
Group=airway
WorkingDirectory=/srv/airway/surgery-Room-Assistant/backend
EnvironmentFile=/etc/airway/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/airway/venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --timeout 600 --access-logfile - --error-logfile - config.wsgi:application
Restart=on-failure
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/airway/media

[Install]
WantedBy=multi-user.target
