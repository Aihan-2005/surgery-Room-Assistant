# Copy to /etc/airway/backend.env on the VPS; keep it outside Git.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
DB_NAME=airway
DB_USER=airway
DB_PASSWORD=replace-with-the-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Optional if pg_dump is not on PATH or is older than the PostgreSQL server.
# PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
MEDIA_ROOT=/var/lib/airway/media
STATIC_ROOT=/var/lib/airway/static
PHOTO_JPEG_QUALITY=90
PHOTO_MAX_UPLOAD_BYTES=5242880
PHOTO_MAX_PIXELS=40000000
REGISTER_RATE=30/hour
RECOVER_RATE=30/hour
NUM_PROXIES=1
HSTS_SECONDS=3600
# Share throttle state between Gunicorn workers. Create this table at deployment.
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=airway_cache
